# PactLens environment template. Copy to .env and fill in locally.
# NEVER commit a real .env file. No secrets belong in this repository.

# Phase 3 optional local Ollama ENGINEERING smoke only. No API key/cloud provider.
# Set both explicitly; use an exact already-installed local model name.
# PACTLENS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# PACTLENS_OLLAMA_MODEL=
# Inference additionally requires --allow-one-local-engineering-episode.
