# PactLens environment template. Copy to .env and fill in locally.
# NEVER commit a real .env file. No secrets belong in this repository.

# Optional: model provider credentials for the OPTIONAL LLM pilot (Phase 3+).
# Leave empty for the deterministic offline pipeline.
# PACTLENS_MODEL_API_KEY=

# Optional: provider base URL / model id overrides for the experiment plane.
# PACTLENS_MODEL_BASE_URL=
# PACTLENS_MONITOR_MODEL=
