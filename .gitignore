# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# IDE / agent workspace state (local memory and tool caches, not project content)
.workbuddy-ai/

# Virtual environments
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state (AIG gate ledgers, consumer effect stores, experiment databases)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.runtime/

# Secrets and environment
.env
.env.*
!.env.example

# Research artifacts that must never contain secrets or unredacted private data
artifacts/**/*.sqlite3

# OS noise
.DS_Store
Thumbs.db

# Review deliverables belong outside the repository; tracked historical ZIPs remain tracked.
/pactlens-phase*-review.zip
